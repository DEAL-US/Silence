{
    "employees_getAll_ok": {
        "description": "GET /employees: returns the current rows",
        "endpoint": "GET /employees",
        "steps": [
            {
                "GET /employees": null,
                "expect": {
                    "status": 200,
                    "count": 5
                }
            }
        ]
    },
    "employees_getById_ok": {
        "description": "GET /employees/$employeeId: returns the current rows",
        "endpoint": "GET /employees/$employeeId",
        "steps": [
            {
                "GET /employees/1": null,
                "expect": {
                    "status": 200,
                    "row": {
                        "bossId": null,
                        "departmentId": 1,
                        "email": "perianez@company.com",
                        "employeeId": 1,
                        "firstName": "Pedro",
                        "isActive": 1,
                        "lastName": "Periáñez",
                        "position": "Manager",
                        "salary": 2300.0
                    },
                    "count": 1
                }
            }
        ]
    },
    "employees_getById_not_found": {
