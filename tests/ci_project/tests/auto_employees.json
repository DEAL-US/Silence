    "employees_flow": {
        "description": "Creates a row of employees, reads it, updates it, deletes it and checks that it is gone",
        "endpoint": "POST /employees (flow)",
        "steps": [
            {
                "request": {
                    "method": "POST",
                    "path": "/employees",
                    "as": 1,
                    "body": {
                        "email": "t7.perianez@company.com",
                        "password": "Test-1234",
                        "departmentId": 1,
                        "bossId": null,
                        "firstName": "Pedro",
                        "lastName": "Periáñez",
                        "salary": 2300.0,
                        "position": "Manager",
                        "isActive": 1
                    }
                },
                "expect": {
                    "status": 201
                },
                "save": {
                    "id": "lastId"
                }
            },
            {
                "request": {
                    "method": "GET",
                    "path": "/employees/${id}"
                },
                "expect": {
                    "status": 200,
                    "row": {
                        "email": "t7.perianez@company.com",
                        "departmentId": 1,
                        "bossId": null,
                        "firstName": "Pedro",
                        "lastName": "Periáñez",
                        "salary": 2300.0,
                        "position": "Manager",
                        "isActive": 1
                    }
                }
            },
            {
                "request": {
                    "method": "PUT",
                    "path": "/employees/${id}",
                    "as": 1,
                    "body": {
                        "email": "t7.perianez@company.com",
                        "password": "Test-1234",
                        "departmentId": 1,
                        "bossId": null,
                        "firstName": "Pedro",
                        "lastName": "Periáñez",
                        "salary": 2300.0,
                        "position": "Manager",
                        "isActive": 1
                    }
                },
                "expect": {
                    "status": 200
                }
            },
            {
                "request": {
                    "method": "DELETE",
                    "path": "/employees/${id}",
                    "as": 1
                },
                "expect": {
                    "status": 200
                }
            },
            {
                "request": {
                    "method": "GET",
                    "path": "/employees/${id}"
                },
                "expect": {
                    "status": 404
                }
            }
        ]
    }
