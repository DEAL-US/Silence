    "employees_flow": {
        "description": "Creates a row of employees, reads it, updates it, deletes it and checks that it is gone",
        "endpoint": "POST /employees (flow)",
        "steps": [
            {
                "POST /employees": {
                    "email": "t7.perianez@company.com",
                    "password": "Test-1234",
                    "departmentId": 1,
                    "bossId": null,
                    "firstName": "Pedro",
                    "lastName": "Periáñez",
                    "salary": 2300.0,
                    "position": "Manager",
                    "isActive": 1
                },
                "as": 1,
                "expect": 201,
                "save": {
                    "id": "lastId"
                }
            },
            {
                "GET /employees/${id}": null,
                "expect": {
                    "status": 200,
                    "row": {
                        "email": "t7.perianez@company.com",
                        "departmentId": 1,
                        "bossId": null,
                        "firstName": "Pedro",
                        "lastName": "Periáñez",
                        "salary": 2300.0,
                        "position": "Manager",
                        "isActive": 1
                    }
                }
            },
            {
                "PUT /employees/${id}": {
                    "email": "t7.perianez@company.com",
                    "password": "Test-1234",
                    "departmentId": 1,
                    "bossId": null,
                    "firstName": "Pedro",
                    "lastName": "Periáñez",
                    "salary": 2300.0,
                    "position": "Manager",
                    "isActive": 1
                },
                "as": 1,
                "expect": 200
            },
            {
                "DELETE /employees/${id}": null,
                "as": 1,
                "expect": 200
            },
            {
                "GET /employees/${id}": null,
                "expect": 404
            }
        ]
    }
