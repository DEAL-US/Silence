{
    "loggedid_endpoints_loggedId_ok": {
        "description": "GET /employees/logged: returns the current rows",
        "endpoint": "GET /employees/logged",
        "steps": [
            {
                "GET /employees/logged": null,
                "as": 1,
                "expect": {
                    "status": 200,
                    "row": {
                        "bossId": null,
                        "departmentId": 1,
                        "email": "perianez@company.com",
                        "employeeId": 1,
                        "firstName": "Pedro",
                        "isActive": 1,
                        "lastName": "Periáñez",
                        "position": "Manager",
                        "salary": 2300.0
                    },
                    "count": 1
                }
            }
        ]
    },
    "loggedid_endpoints_loggedId_no_session": {
        "description": "GET /employees/logged: without a session is a 401",
        "endpoint": "GET /employees/logged",
        "steps": [
            {
                "GET /employees/logged": null,
                "expect": 401
            }
        ]
    },
