    "departments_flow": {
        "description": "Creates a row of departments, reads it, updates it, deletes it and checks that it is gone",
        "endpoint": "POST /departments (flow)",
        "steps": [
            {
                "request": {
                    "method": "POST",
                    "path": "/departments",
                    "as": 1,
                    "body": {
                        "name": "Arte",
                        "city": "Cádiz-t1"
                    }
                },
                "expect": {
                    "status": 201
                },
                "save": {
                    "id": "lastId"
                }
            },
            {
                "request": {
                    "method": "GET",
                    "path": "/departments/${id}"
                },
                "expect": {
                    "status": 200,
                    "row": {
                        "name": "Arte",
                        "city": "Cádiz-t1"
                    }
                }
            },
            {
                "request": {
                    "method": "PUT",
                    "path": "/departments/${id}",
                    "as": 1,
                    "body": {
                        "name": "Arte",
                        "city": "Cádiz-t1"
                    }
                },
                "expect": {
                    "status": 200
                }
            },
            {
                "request": {
                    "method": "DELETE",
                    "path": "/departments/${id}",
                    "as": 1
                },
                "expect": {
                    "status": 200
                }
            },
            {
                "request": {
                    "method": "GET",
                    "path": "/departments/${id}"
                },
                "expect": {
                    "status": 404
                }
            }
        ]
    }
