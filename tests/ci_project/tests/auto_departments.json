    "departments_getAll_ok": {
        "description": "GET /departments: returns the current rows",
        "endpoint": "GET /departments",
        "steps": [
            {
                "request": {
                    "method": "GET",
                    "path": "/departments"
                },
                "expect": {
                    "status": 200,
                    "count": 3
